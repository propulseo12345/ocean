# ---------------------------------------------------------------------------
# Ocean / Socean — apps/web
# Copier ce fichier en `apps/web/.env.local` puis coller les valeurs.
# `.env.local` ne doit JAMAIS etre commite (deja couvert par .gitignore Next).
#
# Regle 25 / anti-pattern CLAUDE.md section 8 :
#   tout ce qui est prefixe NEXT_PUBLIC_ part dans le bundle NAVIGATEUR.
#   La service role key n'est JAMAIS prefixee NEXT_PUBLIC_ — compromission totale.
# ---------------------------------------------------------------------------

# === REQUIS MAINTENANT — Supabase ==========================================
# Dashboard > Project Settings > Data API  (ou "API")

# Deja connu (ton projet)
NEXT_PUBLIC_SUPABASE_URL=https://hgdeopkmkwyoumsfggrm.supabase.co

# Cle publique, exposee au navigateur. C'est normal : la RLS est la vraie barriere.
# Supabase affiche soit "anon public" (JWT eyJ...), soit le nouveau format
# "publishable" (sb_publishable_...). Colle celle que ton dashboard montre.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — serveur uniquement (Server Actions, Route Handlers, worker).
# Dashboard : "service_role secret" (JWT eyJ...) ou "secret" (sb_secret_...).
# Bypasse la RLS : ne jamais l'exposer au client, ne jamais la logger.
SUPABASE_SERVICE_ROLE_KEY=

# === REQUIS POUR LE WORKER (Lot 2) =========================================
# Dashboard > Project Settings > Database > Connection string
# IMPORTANT (regle 17) : mode SESSION, port 5432. JAMAIS le pooler
# transaction 6543 — il casse les advisory locks du worker de publication.
SUPABASE_DB_URL=

# === WORKER EN MODE `live` (phase 6) =======================================
# Le worker (apps/worker, 2e app Coolify) lit LES MEMES noms de variables OAuth
# que le web : ne pas les renommer d'un cote sans l'autre.
# Il lit en plus, et UNIQUEMENT lui :
#   SUPABASE_URL              = meme valeur que NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY = meme valeur que ci-dessus
# Elles servent a UNE chose : signer une URL de lecture TTL 48 h sur le bucket
# prive `media-originals` (regle 20). Instagram et Facebook ne recoivent jamais
# d'octets, ils recoivent une URL qu'ils vont chercher eux-memes.
# Sans elles, `PUBLISHERS_MODE=live` REFUSE DE DEMARRER, en nommant ce qui manque.
SUPABASE_URL=https://hgdeopkmkwyoumsfggrm.supabase.co

# === PLUS TARD — a laisser vide tant que le lot n'est pas ouvert ============

# Brevo (Lot 2 pour les emails d'echec, Lot 3 pour les invitations Reviewer)
BREVO_API_KEY=

# Sentry (web + worker, sourcemaps au build)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog (host EU)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# OAuth plateformes — Route Handlers custom, PAS linkIdentity
# ⚠️ Ces noms sont ceux que le CODE lit reellement (lib/oauth/config.ts,
# champs clientIdEnv / clientSecretEnv). Ne pas les renommer sans changer le code :
# `providerCredentials()` leve et la connexion redirige en ?error=oauth_unconfigured.
OAUTH_META_CLIENT_ID=
OAUTH_META_CLIENT_SECRET=
OAUTH_TIKTOK_CLIENT_KEY=
OAUTH_TIKTOK_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Secret de signature du state OAuth (anti-CSRF). 32+ octets aleatoires.
# Sans lui, signState() leve et les boutons de connexion redirigent proprement
# en ?error=oauth_unconfigured.
OAUTH_STATE_SECRET=

# === URL PUBLIQUE DE L'APP ==================================================
# SITE_URL est la variable OPERANTE, lue au RUNTIME par le serveur :
#   - redirect_uri OAuth (doit correspondre EXACTEMENT aux URIs declarees chez
#     Meta / TikTok / Google / Microsoft) ;
#   - liens des emails et des notifications.
#
# ⚠️ NE PAS utiliser NEXT_PUBLIC_SITE_URL pour ca : Next inline les variables
# NEXT_PUBLIC_* AU BUILD, y compris cote serveur. Verifie sur le bundle de ce
# depot : `.next/server/**/*.js` ne contient plus `process.env.NEXT_PUBLIC_SITE_URL`
# mais la valeur figee du build. Une image construite en local embarquerait donc
# `http://localhost:3000` dans les emails et les redirect_uri de production, et
# la valeur posee dans Coolify serait ignoree.
SITE_URL=http://localhost:3010

# Conserve uniquement si du code CLIENT en a besoin un jour (aucun aujourd'hui).
# Le code serveur ne la lit plus.
# NEXT_PUBLIC_SITE_URL=
